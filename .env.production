# ============================================
# PRODUCTION CONFIGURATION OVERRIDES
# ============================================

ENVIRONMENT=production
RELOAD=false
WORKERS=8

# Production database with SSL
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@${DB_HOST}:5432/transaction_db?sslmode=require

# Production connection pools
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100
DB_POOL_TIMEOUT=10

# JWT with RS256 (using Auth Service JWKS)
JWT_ALGORITHM=RS256
USE_JWKS=true
JWT_ISSUER=https://auth.yourdomain.com

# Logging
LOG_LEVEL=WARNING
LOG_JSON_ENABLED=true

# Rate limiting
ENABLE_RATE_LIMITING=true
BATCH_IMPORT_RATE_LIMIT=50
QUERY_RATE_LIMIT=5000

# Redis for production
REDIS_ENABLED=true
REDIS_URL=redis://redis-cluster:6379/0

# Security
ENABLE_HTTPS_REDIRECT=true
ENABLE_HSTS=true
CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# Monitoring
ENABLE_METRICS=true
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=production

# Error tracking
DEV_MODE=false
DEV_SKIP_JWT_VERIFICATION=false