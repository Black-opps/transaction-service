# ============================================
# TRANSACTION SERVICE ENVIRONMENT VARIABLES
# ============================================

# Service Configuration
ENVIRONMENT=development
RELOAD=true
WORKERS=1

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/transaction_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# JWT Configuration (RS256 from Auth Service)
JWT_ALGORITHM=RS256
USE_JWKS=true
JWT_ISSUER=http://localhost:8001
JWKS_URL=http://localhost:8001/.well-known/jwks.json

# Logging
LOG_LEVEL=INFO
LOG_JSON_ENABLED=false

# Rate Limiting
ENABLE_RATE_LIMITING=true
BATCH_IMPORT_RATE_LIMIT=100
QUERY_RATE_LIMIT=10000

# Redis (optional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Security (development)
ENABLE_HTTPS_REDIRECT=false
ENABLE_HSTS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:9000

# Monitoring
ENABLE_METRICS=true
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Error tracking
DEV_MODE=true
DEV_SKIP_JWT_VERIFICATION=true
